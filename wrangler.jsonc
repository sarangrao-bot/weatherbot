{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weatherbot",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  }
}
